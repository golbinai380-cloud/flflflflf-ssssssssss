# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_APP_ID=your_app_id_here
TELEGRAM_APP_HASH=your_app_hash_here

# Admin Configuration
ADMIN_ID=your_admin_telegram_id_here
ADMIN_USERNAME=your_admin_username

# Service Account (для продажи подарков и получения звёзд)
SERVICE_ACCOUNT_ID=your_service_account_id_here
SERVICE_ACCOUNT_PHONE=+1234567890
SERVICE_ACCOUNT_PASSWORD=your_service_account_password

# Telegram Gift API (https://core.telegram.org/api/gifts)
TELEGRAM_API_ENDPOINT=https://api.telegram.org
USE_REAL_TELEGRAM_API=true
AUTO_SELL_GIFTS=true
MIN_STARS_FOR_TRANSFER=10

# Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_APP_URL=https://darkshop.live
DEBUG=False

# Database (SQLite создается автоматически в backend/database.db)
# Для собственной БД используйте: postgresql://user:password@localhost/dbname
# или: mysql://user:password@localhost/dbname
DATABASE_URL=sqlite

# Security
SECRET_KEY=your_secret_key_here

